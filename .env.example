# ============================================================
# backend/.env.example — Salin file ini menjadi backend/.env
# Jangan pernah commit file .env ke Git!
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database ────────────────────────────────────────────────
# Di Railway: tambahkan plugin PostgreSQL, lalu salin DATABASE_URL
# dari tab Variables plugin PostgreSQL ke environment variables service backend.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/berkesan

# Pool connection
DB_POOL_MAX=20
DB_POOL_MIN=5

# ─── JWT ─────────────────────────────────────────────────────
# Ganti dengan string acak yang panjang dan aman!
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_EXPIRES_IN=7d

# ─── Security ────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ─── CORS ────────────────────────────────────────────────────
# URL frontend Vercel yang diizinkan memanggil API ini.
# Isi setelah deploy frontend ke Vercel, pisah koma jika lebih dari satu.
# Contoh: https://berkesan-coffee.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ─── Payment Gateway (opsional) ──────────────────────────────
# PAYMENT_GATEWAY=midtrans
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# MIDTRANS_ENV=sandbox

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info
